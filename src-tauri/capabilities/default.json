{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$HOME/**/*.pdf"
        },
        {
          "path": "$HOME/**/*.epub"
        },
        {
          "path": "$HOME/**/*.txt"
        },
        {
          "path": "$HOME/**/*.PDF"
        },
        {
          "path": "$HOME/**/*.EPUB"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/georgerahul24/Syncer/*"
        }
      ]
    },
    "process:allow-restart"
  ]
}
