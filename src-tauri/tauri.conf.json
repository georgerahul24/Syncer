{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syncer",
  "version": "0.2.0",
  "identifier": "in.georgerahul24.syncer",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace=frontend",
    "beforeBuildCommand": "npm run build --workspace=frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Syncer",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer"
      },
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "EPUB eBook",
        "role": "Viewer"
      }
    ]
  }
}
