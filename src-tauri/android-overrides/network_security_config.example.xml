<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds block cleartext (plain http://) traffic by default. Server
     addresses are user-editable in the app (Servers dialog), and a home LAN
     server is usually plain http, so cleartext is allowed for any host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
